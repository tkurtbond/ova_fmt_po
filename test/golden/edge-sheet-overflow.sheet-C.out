.\" ova_fmt -S: the OVA character sheet's values, to be typeset
.\" with groff -k -Tpdf and laid over the blank sheet (ova_sheet.sh).
.pl 595.276p
.po 0
.nh
.ad l
.defcolor ovared rgb 0.47 0.11 0.13
.nr started 0
.nr cont 0
.de L
.sp |\\$1p-1p
.in \\$2p
..
.de HD
.if \\n[cont] 'sp |36p
..
.wh 0 HD
.de FT
'bp
..
.de SP
.ch FT
.nr cont 0
.if \\n[started] .bp
.nr started 1
.nf
.vs 1p
.tm ova-sheet-page \\n% \\$1
..
.de CP
.nr cont 1
.if \\n[started] .bp
.nr started 1
.wh -40p FT
.fi
.in 36p
.ll 383.528p
.vs 11p
..
.de PT
.if d ova-portrait-\\$1 \\X'pdf: pdfpic \\*[ova-portrait-\\$1] -L \\$2p \\$3p'
..
.de SH
.sp 8p
.ne 4v
.ft NSB
.ps 10
..
.de PP
.br
.ft NSR
.ps 9
.sp 3p
..
.\" ova-sheet-redrawn
.\" -R: the sheet's frames and labels drawn here, not taken from the
.\" blank sheet; FR-p1 and FR-p2 draw a page's, under its text.
.defcolor ovasheetgrey cmyk 0.065 0.1 0.072 0
.defcolor ovasheetred rgb 0.451 0.114 0.126
.de AT
.sp |\\$1-1p
.in \\$2
..
.de RF
.nr rf-x \\$1p
.nr rf-y \\$2p
.nr rf-w \\$3p
.nr rf-h \\$4p
.nr rf-r \\$5p
.nr rf-d 2*\\n[rf-r]
.AT \\n[rf-y]u+\\n[rf-r]u \\n[rf-x]u
\M[\\$6]\D'P \\n[rf-w]u 0 0 \\n[rf-h]u-\\n[rf-d]u -\\n[rf-w]u 0 0 \\n[rf-d]u-\\n[rf-h]u'\M[]
.AT \\n[rf-y]u \\n[rf-x]u+\\n[rf-r]u
\M[\\$6]\D'P \\n[rf-w]u-\\n[rf-d]u 0 0 \\n[rf-h]u \\n[rf-d]u-\\n[rf-w]u 0 0 -\\n[rf-h]u'\M[]
.if \\n[rf-r] \{\
.AT \\n[rf-y]u+\\n[rf-r]u \\n[rf-x]u
\M[\\$6]\D'C \\n[rf-d]u'\h'\\n[rf-w]u-\\n[rf-d]u-\\n[rf-d]u'\D'C \\n[rf-d]u'\M[]
.AT \\n[rf-y]u+\\n[rf-h]u-\\n[rf-r]u \\n[rf-x]u
\M[\\$6]\D'C \\n[rf-d]u'\h'\\n[rf-w]u-\\n[rf-d]u-\\n[rf-d]u'\D'C \\n[rf-d]u'\M[]
.\}
..
.de HR
.AT \\$2p \\$1p
\m[ovasheetred]\D't 0.5p'\D'l \\$3p 0'\m[]
..
.de VR
.AT \\$2p \\$1p
\m[ovasheetred]\D't 0.5p'\D'l 0 \\$3p'\v'-\\$3p'\m[]
..
.ds dots
.nr dots 0 1
.while \n+[dots]<=177 .as dots \M[ovasheetgrey]\D'C 1p'\M[]\h'1.003p'
.de TX
.AT \\$2p \\$1p
.ds tx-f \\$3
.nr tx-h \\$4p
.nr tx-t \\$5p
.ds tx-c \\$6
.shift 6
.nr tx-w \w'\f[\\*[tx-f]]\s'\\n[tx-h]u'\\$*'
.nr tx-s \\n[tx-h]/10*\\n[tx-t]/(\\n[tx-w]/10)
\f[\\*[tx-f]]\s'\\n[tx-s]u'\H'\\n[tx-h]u'\m[\\*[tx-c]]\\$*\m[]\H'0'\s[0]\f[]
..
.de FR-p1
.RF 23.75 364.846 412.75 201.87 8 ovasheetgrey
