.L 142.70 65.20
\f[NSR]\s[7]X2; FLAWS: FEATHER BLOW, LOW
.L 155.70 65.20
\f[NSR]\s[7]PENETRATION X2; 5 ENDURANCE\f[NSI]\s[8]]
.L 168.70 39.47
\f[NSR]\s[8]+1
.L 168.70 59.20
\f[NSI]\s[8]Quick
.L 116.70 220.66
\f[NSR]\s[8]−2
.L 116.70 240.30
\f[NSI]\s[8]Vulnerability (Heat/Cold)
.SP p2
