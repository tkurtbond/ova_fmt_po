.\" ova_fmt -S: the OVA character sheet's values, to be typeset
.\" with groff -k -Tpdf and laid over the blank sheet (ova_sheet.sh).
.pl 595.276p
.po 0
.nh
.ad l
.defcolor ovared rgb 0.47 0.11 0.13
.nr started 0
.nr cont 0
.de L
.sp |\\$1p-1p
.in \\$2p
..
.de HD
.if \\n[cont] 'sp |36p
..
.wh 0 HD
.de FT
'bp
..
.de SP
.ch FT
.nr cont 0
.if \\n[started] .bp
.nr started 1
.nf
.vs 1p
.tm ova-sheet-page \\n% \\$1
..
.de CP
.nr cont 1
.if \\n[started] .bp
.nr started 1
.wh -40p FT
.fi
.in 36p
.ll 383.528p
.vs 11p
..
.de PT
.if d ova-portrait-\\$1 \\X'pdf: pdfpic \\*[ova-portrait-\\$1] -L \\$2p \\$3p'
..
.de SH
.sp 8p
.ne 4v
.ft NSB
.ps 10
..
.de PP
.br
.ft NSR
.ps 9
.sp 3p
..
.SP p1
.L 49.31 148.50
\f[NSR]\s[12]Shady Teacher
.L 116.70 39.47
\f[NSR]\s[8]+2
.L 116.70 59.20
\f[NSI]\s[8]Art of Invisibility
.L 129.70 39.47
\f[NSR]\s[8]+2
.L 129.70 59.20
\f[NSI]\s[8]Perceptive
.L 142.70 39.47
\f[NSR]\s[8]+3
.L 142.70 59.20
\f[NSI]\s[8]Smart
.L 116.70 220.66
\f[NSR]\s[8]−1
.L 116.70 240.30
\f[NSI]\s[8]Absent-Minded
.L 129.70 220.66
\f[NSR]\s[8]−1
.L 129.70 240.30
\f[NSI]\s[8]Fussy
.L 142.70 220.66
\f[NSR]\s[8]−1
.L 142.70 240.30
\f[NSI]\s[8]Quirk (Always Wears Sunglasses)
.L 155.70 220.66
\f[NSR]\s[8]−2
.L 155.70 240.30
\f[NSI]\s[8]Secret (To Everybody)
.SP p2
.L 47.69 38.70
\f[NSR]\s[8]The **Shady Teacher** just joined the faculty and
.L 57.69 38.70
\f[NSR]\s[8]seems to know his subject, yet something about
.L 67.69 38.70
\f[NSR]\s[8]him is wrong. Perhaps it's the sunglasses he never
.L 77.69 38.70
\f[NSR]\s[8]takes off, even inside -- or the students who keep
.L 87.69 38.70
\f[NSR]\s[8]vanishing from his class.
