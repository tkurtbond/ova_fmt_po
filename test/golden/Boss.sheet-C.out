.TX 211.47 541.496 NSR 11 43.05 ovasheetred HEALTH
.TX 271.48 541.496 NSR 11 68.31 ovasheetred ENDURANCE
.TX 356.47 541.496 NSR 11 13.61 ovasheetred TV
..
.de FR-p2
.RF 0 0 419.528 595.276 0 ovasheetgrey
.RF 32.78 19.346 238.22 307.93 8 white
.RF 31.78 340.066 172 165.3 8 white
.RF 211.36 340.066 172 165.3 8 white
.RF 31.78 516.116 351.58 58.5 8 white
.RF 238.78 0 166.22 36.006 0 ovasheetred
.RF 238.78 17.996 166.22 310.62 14 ovasheetred
.RF 240.78 19.996 162.22 306.62 12 white
.TX 36.4 36.996 NSXCB 16 58.88 ovasheetred Background
.TX 36 356.996 NSXCB 16 58.51 ovasheetred Appearance
.TX 219.76 356.996 NSXCB 16 58 ovasheetred Personality
.TX 36 534 NSXCB 16 60.59 ovasheetred Other Notes
.TX 285.02 14.996 NSXCB 12 73.74 ovasheetgrey CHARACTER PORTRAIT
..
.\" -R: continuation pages drawn to match the sheet's; HD draws each one.
.de FR-cp
.RF 0 0 419.528 595.276 0 ovasheetgrey
.RF 31.78 37 351.58 540 15 ovasheetred
.RF 33.78 39 347.58 536 13 white
.RF 31.78 24 351.58 27.62 12 ovasheetred
.RF 31.78 42 351.58 9.62 0 ovasheetred
.TX 37.39 47.65 NSXCB 24 73.83 white Continued
..
.nr drawing 0
.de FT
.if !\\n[drawing] 'bp
..
.de HD
.if \\n[cont] \{\
.nr drawing 1
.ev ova-draw
.nf
.vs 1p
.FR-cp
.ev
.nr drawing 0
'sp |64p
.\}
..
.am CP
.in 44p
.ll 371p
..
.am SH
.ft NSCSB
.ps 12
.gcolor ovasheetred
..
.am PP
.gcolor default
..
.\" -C: page 1 as one column beside an Attacks & Combat Stats box.
.defcolor ovasheetrule gray 0.75
.de CR
.RF 40.47 \\$1 124 0.6 0 ovasheetrule
..
.de FR-p1c
.RF -8.64 85.866 404.64 490 8 ovasheetgrey
