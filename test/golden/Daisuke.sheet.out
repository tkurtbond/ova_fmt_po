.if \\n[cont] 'sp |36p
..
.wh 0 HD
.de FT
'bp
..
.de SP
.ch FT
.nr cont 0
.if \\n[started] .bp
.nr started 1
.nf
.vs 1p
.tm ova-sheet-page \\n% \\$1
